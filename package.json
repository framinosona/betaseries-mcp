{
  "name": "betaseries-mcp",
  "version": "0.1.0",
  "description": "Open-source MCP server exposing the full BetaSeries API (TV shows, movies, tracking, planning, social).",
  "type": "module",
  "license": "MIT",
  "author": "François Raminosona",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framinosona/betaseries-mcp.git"
  },
  "bin": {
    "betaseries-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "spec"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "codegen": "tsx scripts/generate-tools.ts",
    "build": "npm run codegen && tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/setup/auth-cli.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}

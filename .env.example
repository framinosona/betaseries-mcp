# Get an API key at https://www.betaseries.com/api (or via the developer portal
# at https://developers.betaseries.com/) — required for every request.
BETASERIES_API_KEY=

# Only needed to run `npm run auth` (the one-time OAuth device-code login).
# Found alongside your API key in your BetaSeries API key details.
BETASERIES_API_SECRET=

# Filled in automatically by `npm run auth` — a member access token, required
# for anything that reads/writes your BetaSeries account (tracking, ratings,
# planning, etc). Read-only calls that don't need a member context (e.g. some
# show/movie search & display operations) work without it.
BETASERIES_ACCESS_TOKEN=

# Optional overrides — sane defaults for all of these.
# BETASERIES_LOCALE=fr
# BETASERIES_API_BASE_URL=https://api.betaseries.com
# BETASERIES_API_VERSION=3.0

# Transport: "stdio" (default, for local MCP clients) or "http" (for Docker /
# self-hosting, Streamable HTTP on PORT below).
# MCP_TRANSPORT=stdio
# PORT=3000
